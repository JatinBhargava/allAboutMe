# Spotify "now playing" widget (server-side only; never prefix these with VITE_)
# See scripts/spotify-auth.mjs for how to get them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# "Currently reading" card: your Goodreads profile URL, or just the number in it
# (goodreads.com/user/show/12345678-name -> 12345678). Your shelves must be public.
GOODREADS_USER_ID=

# "Last watched" card: IMDb link (or tt id) of what you last watched.
# IMDb has no public watch-history feed, so update this when you watch something new.
# Title, year, poster and IMDb rating come from OMDb: get a free key at
# https://www.omdbapi.com/apikey.aspx (the key alone, or the whole sample link from the email;
# activate it via the link in that email first)
IMDB_LAST_WATCHED=
OMDB_API_KEY=
# Optional: your rating out of 10, and the date you watched it (YYYY-MM-DD)
IMDB_MY_RATING=
IMDB_WATCHED_ON=

# "VS Code usage" card: install the WakaTime VS Code extension, then copy
# your key from https://wakatime.com/settings/api-key
WAKATIME_API_KEY=

# Chess (Jatin vs visitors). Any long random string; open the site once with
# ?chess-owner=<this value> to play white as Jatin on that browser.
CHESS_OWNER_KEY=    
# Shared storage for the game when deployed (Vercel -> Storage -> Upstash Redis
# sets these automatically). Locally the game is stored in .data/ instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
